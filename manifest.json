{
    "manifest_version": 3,
    "name": "Auto-Doc",
    "version": "1.1.0",
    "description": "Создает калькуляцию в базе данных.",
    "icons": {
        "64": "./app/icons/doc64.png"
    },
    "action": {
        "default_popup": "app/popup.html"
    },
    "permissions": [
        "scripting",
        "tabs",
        "activeTab",
        "alarms",
        "storage"
    ],
    "host_permissions": ["https://kuban.rossko.ru/*", "https://rossko.ru/*", "http://localhost:5050/*", "http://127.0.0.1:8080/*"],
    "background": {
        "service_worker": "app/background.js",
        "type": "module"
    }
}