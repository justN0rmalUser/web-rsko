{
    "manifest_version": 3,
    "name": "Auto-Calc",
    "version": "1.0",
    "description": "Создает калькуляцию в базе данных.",
    "icons": {
        "64": "/icons/icon64.png"
    },
    "action": {
        "default_popup": "app/popup.html"
    },
    "permissions": [
        "scripting",
        "tabs",
        "activeTab",
        "alarms",
        "storage"
    ],
    "host_permissions": ["https://*.rossko.ru/*", "https://rossko.ru/*", "http://localhost:5050/data", "http://127.0.0.1:5050"],
    "background": {
        "service_worker": "app/background.js"
    }
}